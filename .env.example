# ==========================================
# LEAD ANALYZER - ENVIRONMENT CONFIGURATION
# ==========================================

# Environment: development / production
NODE_ENV=development

# Server
PORT=3000

# ==========================================
# DATABASE
# ==========================================

# Local development:
DATABASE_PATH=./leads.db

# ==========================================
# OPENAI
# ==========================================

OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# AUTH
# ==========================================

# Minimum 32 characters.
# Production should use a long cryptographically random value.
JWT_SECRET=your_long_random_jwt_secret_here

# ==========================================
# BILLING
# ==========================================

# Development only.
# MUST be false in production.
BILLING_TEST_MODE=false

# ==========================================
# PRZELEWY24
# ==========================================

# sandbox / production
P24_MODE=sandbox

P24_MERCHANT_ID=your_merchant_id_here

# Optional if identical to P24_MERCHANT_ID.
P24_POS_ID=your_pos_id_here

P24_CRC=your_crc_here
P24_API_KEY=your_api_key_here
